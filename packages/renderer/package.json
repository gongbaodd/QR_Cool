{
  "name": "@mahu-qr/renderer",
  "version": "0.1.0",
  "description": "Generate artistic QR posters from mahu-QR portable recipe JSON.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gongbaodd/QR_Cool.git",
    "directory": "packages/renderer"
  },
  "files": [
    "src/",
    "dist/node.js",
    "dist/types/",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/worker-shim.ts"
  ],
  "exports": {
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node.js"
    },
    "./core/artifacts": "./src/core/artifacts.ts",
    "./core/assemble": "./src/core/assemble.ts",
    "./core/errors": "./src/core/errors.ts",
    "./core/export-sizes": "./src/core/export-sizes.ts",
    "./core/image": "./src/core/image.ts",
    "./core/imaging/browser": "./src/core/imaging/browser.ts",
    "./core/imaging/cloudflare": "./src/core/imaging/cloudflare.ts",
    "./core/imaging": "./src/core/imaging/index.ts",
    "./core/imaging/node": "./src/core/imaging/node.ts",
    "./core/imaging/pixels": "./src/core/imaging/pixels.ts",
    "./core/imaging/types": "./src/core/imaging/types.ts",
    "./core/mask": "./src/core/mask.ts",
    "./core/module-cut": "./src/core/module-cut.ts",
    "./core/palette": "./src/core/palette.ts",
    "./core/pattern-cut": "./src/core/pattern-cut.ts",
    "./core/pattern": "./src/core/pattern.ts",
    "./core/placement": "./src/core/placement.ts",
    "./core/qr": "./src/core/qr.ts",
    "./core/rotate": "./src/core/rotate.ts",
    "./core/squircle": "./src/core/squircle.ts",
    "./core/types": "./src/core/types.ts",
    "./engine": "./src/engine/index.ts",
    "./engine/pipeline": "./src/engine/pipeline.ts",
    "./schema": "./src/schema.ts",
    "./png-guard": "./src/png-guard.ts",
    "./recipe": "./src/recipe.ts",
    "./worker-shim": "./src/worker-shim.ts"
  },
  "scripts": {
    "build": "pnpm exec esbuild src/node.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/node.js && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jsquash/png": "^3.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@zxing/library": "^0.23.0",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.4",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
