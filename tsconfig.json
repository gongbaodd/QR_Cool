{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": { "@/*": ["./apps/web/src/*"] }
  },
  "include": [
    "test/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/render-api/src/**/*.ts",
    "packages/renderer/src/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "cucumber.mjs"
  ],
  "exclude": ["node_modules", "apps/web/.next", "dist"]
}
