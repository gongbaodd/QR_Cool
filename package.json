{
  "name": "qr-cool",
  "version": "0.1.0",
  "private": true,
  "description": "Web editor for artistic QR posters",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:bdd": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@jsquash/png": "^3.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@stylexjs/stylex": "^0.19.1",
    "@zxing/library": "^0.23.0",
    "comlink": "^4.4.2",
    "jsqr": "^1.4.0",
    "konva": "^10.5.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.58.2",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2"
}
