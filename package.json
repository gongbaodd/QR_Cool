{
  "name": "mahu-qr",
  "version": "0.1.0",
  "private": true,
  "description": "Web editor for artistic QR posters",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:bdd": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "preview:workers": "wrangler dev --config dist/server/wrangler.json",
    "deploy:workers": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "dev:render-worker": "wrangler dev --config wrangler.render.jsonc",
    "deploy:render-worker": "wrangler deploy --config wrangler.render.jsonc"
  },
  "dependencies": {
    "@jsquash/png": "^3.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@simonwep/pickr": "^1.10.2",
    "@stylexjs/stylex": "^0.19.1",
    "@zxing/library": "^0.23.0",
    "comlink": "^4.4.2",
    "jsqr": "^1.4.0",
    "motion": "^13.4.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-toastify": "^11.1.0",
    "uqr": "^0.1.3",
    "wired-elements": "3.0.0-rc.6",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.58.2",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "autoprefixer": "^10.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react-server-dom-webpack": "^19.2.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.10",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.135.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,scss,less,json,jsonc,json5,md,mdx,yaml,yml,html}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "roughjs": "4.3.1"
    }
  }
}
