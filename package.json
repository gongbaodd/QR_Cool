{
  "name": "qr-cool",
  "version": "0.1.0",
  "private": true,
  "description": "Local dry-run preparation CLI for artistic QR posters",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "qr-poster": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev --webpack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preqr-poster": "tsc -p tsconfig.cli.json",
    "qr-poster": "node dist/cli.js",
    "start": "next start",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "commander": "^15.0.0",
    "jsqr": "^1.4.0",
    "konva": "^10.5.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "sharp": "^0.35.4",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
